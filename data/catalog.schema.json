{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fingerprint browser directory catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_at",
    "review_after_days",
    "preferred_product",
    "affiliate_url",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "review_after_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "preferred_product": {
      "type": "string"
    },
    "affiliate_url": {
      "type": "string",
      "format": "uri"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profiles",
        "amount",
        "currency",
        "billing_period",
        "price_type",
        "site",
        "profile_scope",
        "users_count",
        "users_label",
        "create_limit",
        "create_period",
        "open_limit",
        "recreation_limit",
        "monthly_additional_create",
        "monthly_additional_open",
        "intro_profiles",
        "intro_months",
        "trial_days",
        "api",
        "rpa",
        "sync",
        "source_ids",
        "checked_at",
        "confidence",
        "conflict_note",
        "conditions",
        "proxy_mb_once",
        "mobile_minutes_once",
        "mobile_profiles_once",
        "runtime_minutes",
        "concurrent_profiles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "enum": [
                "unlimited",
                null
              ]
            }
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "enum": [
            "CNY",
            "USD",
            "EUR",
            null
          ]
        },
        "billing_period": {
          "enum": [
            "free",
            "month",
            "year"
          ]
        },
        "price_type": {
          "enum": [
            "free",
            "fixed",
            "dynamic",
            "starting"
          ]
        },
        "site": {
          "enum": [
            "cn",
            "international"
          ]
        },
        "profile_scope": {
          "enum": [
            "browser",
            "cloud_mobile_and_browser",
            "cloud_browser"
          ]
        },
        "users_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "users_label": {
          "type": "string",
          "minLength": 0
        },
        "create_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "create_period": {
          "enum": [
            "day",
            "calendar_month",
            null
          ]
        },
        "open_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recreation_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "monthly_additional_create": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "monthly_additional_open": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "intro_profiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "intro_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trial_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "api": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rpa": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sync": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "enum": [
            "verified",
            "source_conflict",
            "needs_confirmation"
          ]
        },
        "conflict_note": {
          "type": "string"
        },
        "conditions": {
          "type": "string"
        },
        "proxy_mb_once": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mobile_minutes_once": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mobile_profiles_once": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "runtime_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "enum": [
                "unlimited",
                null
              ]
            }
          ]
        },
        "concurrent_profiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "site",
        "document",
        "official_url",
        "checked_at",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "site": {
          "enum": [
            "cn",
            "international"
          ]
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "detail_path",
        "official_url",
        "featured_plan",
        "summary",
        "sources",
        "plans",
        "os_support",
        "price_note",
        "runtime_mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "detail_path": {
          "type": "string",
          "pattern": "^browsers/[a-z0-9-]+\\.md$"
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "featured_plan": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plan"
          }
        },
        "os_support": {
          "type": "object",
          "required": [
            "windows",
            "macos",
            "linux"
          ],
          "additionalProperties": false,
          "properties": {
            "windows": {
              "type": [
                "string",
                "null"
              ]
            },
            "macos": {
              "type": [
                "string",
                "null"
              ]
            },
            "linux": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "price_note": {
          "type": "string"
        },
        "free_summary": {
          "type": "string",
          "minLength": 1
        },
        "runtime_mode": {
          "type": "string",
          "minLength": 1
        },
        "engine_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
